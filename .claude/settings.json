{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "conductor",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(yarn test *)",
      "Bash(yarn lint *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(go test *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(make test *)",
      "Bash(make lint *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh label list *)",
      "Bash(gh label create *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue edit * --add-label needs-decision)",
      "Bash(gh issue edit --add-label needs-decision *)"
    ],
    "ask": [
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh label delete *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(gh issue edit *ready*)",
      "Bash(gh issue create *ready*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
